# 転送先の外部 LLM（OpenAI 互換 API）。値は .env に書き、.env はコミットしない
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# 空ならクライアントが指定した model をそのまま渡す
OPENAI_MODEL=

# Stage 3（ローカル LLM 判定）の Ollama
OLLAMA_BASE_URL=http://localhost:11434
# 空なら config/policy.yaml の llm_judge.model を使う
OLLAMA_MODEL=

# 設定ファイルとデータの場所（既定のままで動く）
GUARD_POLICY_PATH=config/policy.yaml
GUARD_RULES_PATH=config/rules.yaml
GUARD_DATA_DIR=data
